<% content_for :title, "Accept invitation" %>

<h1 class="auth__title">Join <%= @user.account.name %></h1>

<%= form_with model: @user, url: invitation_path(params[:token]), method: :patch, class: "form" do |form| %>
  <%= render "shared/form_errors", model: @user %>

  <div class="field">
    <span class="field__label">Email address</span>
    <p><%= @user.email_address %></p>
  </div>

  <div class="field">
    <%= form.label :name, "Your name" %>
    <%= form.text_field :name, autocomplete: "name" %>
  </div>

  <div class="field">
    <%= form.label :password, "Choose a password" %>
    <%= form.password_field :password, autofocus: true, autocomplete: "new-password", maxlength: 72 %>
    <p class="field__hint">At least 8 characters.</p>
  </div>

  <div class="field">
    <%= form.label :password_confirmation, "Repeat password" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div class="form__actions">
    <%= form.submit "Accept invitation", class: "btn btn--primary" %>
  </div>
<% end %>