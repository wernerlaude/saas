<%#= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%#= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<% content_for :title, "Sign in" %>

<h1 class="auth__title">Sign in</h1>

<%= form_with url: session_path, class: "form" do |form| %>
  <div class="field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autofocus: true,
                         autocomplete: "username", value: params[:email_address] %>
  </div>

  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true,
                            autocomplete: "current-password", maxlength: 72 %>
  </div>

  <div class="form__actions">
    <%= form.submit "Sign in", class: "btn btn--primary" %>
  </div>
<% end %>

<p class="auth__links">
  <%= link_to "Forgot password?", new_password_path %>
  <%= link_to "Create an account", new_registration_path %>
</p>