<header class="app-header">
  <%= link_to "SaaS App", root_path, class: "app-header__brand" %>

  <button class="btn btn--ghost app-header__user" popovertarget="user-menu">
    Hi, <%= Current.user.name %>
    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
      <path d="M5.3 7.3a1 1 0 0 1 1.4 0L10 10.6l3.3-3.3a1 1 0 1 1 1.4 1.4l-4 4a1 1 0 0 1-1.4 0l-4-4a1 1 0 0 1 0-1.4z"/>
    </svg>
  </button>

  <div id="user-menu" class="menu" popover>
    <%= link_to "Profile", "#" %>
    <%= link_to "Settings", "#" %>
    <hr>
    <%# Kapitel 4: button_to "Log Out", session_path, method: :delete %>
    <%= button_to "Log Out", session_path, method: :delete %>
  </div>
</header>
