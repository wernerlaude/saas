<%= form_with model: user,
              url: user.new_record? ? account_users_path : account_user_path(user),
              class: "form" do |form| %>
  <%= render "shared/form_errors", model: user %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, autofocus: true %>
  </div>

  <div class="field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address %>
    <% if user.new_record? %>
      <p class="field__hint">We'll send the invitation to this address.</p>
    <% end %>
  </div>

  <div class="field">
    <%= form.label :role %>
    <%= form.select :role, User.roles.keys.map { |role| [ role.humanize, role ] } %>
    <p class="field__hint">Admins can invite, edit and remove team members.</p>
  </div>

  <div class="form__actions">
    <%= form.submit user.new_record? ? "Send invitation" : "Save", class: "btn btn--primary" %>
    <%= link_to "Cancel", account_users_path, class: "btn btn--ghost" %>
  </div>
<% end %>
