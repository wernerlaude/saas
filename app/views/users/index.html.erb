<% content_for :title, "Team members" %>

<div class="page-header">
  <h1>Team members</h1>
  <div class="page-header__actions">
    <%= link_to "Invite user", new_account_user_path, class: "btn btn--primary" %>
  </div>
</div>

<div class="table-wrap">
  <table class="table">
    <thead>
    <tr>
      <th>Name</th>
      <th>Email</th>
      <th>Role</th>
      <th>Status</th>
      <th><span class="visually-hidden">Actions</span></th>
    </tr>
    </thead>
    <tbody>
    <% @users.each do |user| %>
      <tr id="<%= dom_id(user) %>">
        <td>
          <%= user.name %>
          <% if user == current_user %><span class="muted small">(you)</span><% end %>
        </td>
        <td><%= user.email_address %></td>
        <td>
          <span class="badge <%= "badge--accent" if user.admin? %>"><%= user.role.humanize %></span>
        </td>
        <td>
          <% if user.invitation_pending? %>
            <span class="badge badge--warning">Invited</span>
          <% else %>
            <span class="badge badge--success">Active</span>
          <% end %>
        </td>
        <td class="table__actions">
          <%= link_to "Edit", edit_account_user_path(user), class: "btn btn--ghost" %>
          <% unless user == current_user %>
            <%= button_to "Remove", account_user_path(user), method: :delete,
                          class: "btn btn--ghost btn--danger",
                          form: { data: { turbo_confirm: "Remove #{user.name} from the account?" } } %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>